# ─── Layer 1: Shared defaults across all environments ─────────────────────────
# Keys are flattened with __ (double underscore) to represent nesting.
# SCREAMING_SNAKE_CASE segments are converted to camelCase by the parser.
# Do NOT put environment-specific or sensitive values here.

# ── Service ports ────────────────────────────────────────────────────────────
SERVICES__API__PORT=3000
SERVICES__API__HEALTH_CHECK=/api/health

SERVICES__WEB__PORT=4200
SERVICES__WEB__HEALTH_CHECK=/

# ── Database images (pin to a specific digest in production) ─────────────────
DATABASES__MYSQL__PORT=3306
DATABASES__MYSQL__IMAGE=mariadb:10.11

DATABASES__MONGODB__PORT=27017
DATABASES__MONGODB__IMAGE=mongo:7

DATABASES__REDIS__PORT=6379
DATABASES__REDIS__IMAGE=redis:7-alpine
