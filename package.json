{
  "name": "@lamassau/groma",
  "version": "0.1.0",
  "private": false,
  "description": "Deploy containerized applications to Compose hosts or Kubernetes",
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "scripts": {
    "import": "echo 'cdk8s import disabled: using committed src/lib/k8s.ts'",
    "build": "tsc --noEmit",
    "synth": "cdk8s synth",
    "synth:local": "APP_ENV=local cdk8s synth",
    "synth:dev": "APP_ENV=dev cdk8s synth",
    "synth:staging": "APP_ENV=staging cdk8s synth",
    "synth:prod": "APP_ENV=prod cdk8s synth",
    "diff:local": "node scripts/diff.cjs local",
    "diff:dev": "node scripts/diff.cjs dev",
    "apply:local": "APP_ENV=local cdk8s synth && kubectl apply -f dist/",
    "apply:dev": "APP_ENV=dev cdk8s synth && kubectl apply -f dist/",
    "clean": "rm -rf dist imports out",
    "watch": "tsc --watch",
    "test": "jest",
    "test:cov": "jest --coverage",
    "compile": "tsc -p tsconfig.build.json && node scripts/build-assets.cjs",
    "prepack": "pnpm run compile",
    "groma": "tsx src/cli.ts",
    "test:integration": "node scripts/smoke-compose.cjs",
    "test:agent": "python3 -m unittest discover -s test -p '*_test.py'"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.spec.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "dependencies": {
    "cdk8s": "^2.68.0",
    "constructs": "^10.4.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "cdk8s-cli": "^2.198.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "groma": "build/cli.js"
  },
  "files": [
    "build",
    "README.md",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3"
}
